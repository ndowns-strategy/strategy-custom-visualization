<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE StyleCatalog SYSTEM "styleCatalog.dtd">
<StyleCatalog version="2.0">
    <Styles>
        <!-- name must match style-name in config/visualizations.xml; description is not shown to users. -->
        <Style name="SvTemplate" description="__SV_TITLE__" transform="ReportAjaxMojoVisualizationTransform">
            <ActualParameters>
                <ActualParameter name="documentStyle" type="1" value="RWGridJsonStyle"/>
                <ActualParameter name="reportXMLStyle" type="1" value="VisualizationServerJsonDataStyle"/>
                <ActualParameter name="mojoClassName" type="1" value="plugins.SvTemplate.SvTemplate"/>
            </ActualParameters>
            <Layouts>
                <Layout layout_source="AppLayoutSourceFile" order="1">
                    <![CDATA[/WEB-INF/xml/layouts/MojoVisualizationLayout.xml]]>
                </Layout>
            </Layouts>
        </Style>
    </Styles>
</StyleCatalog>
