<visualizations>
    <!-- scope 19 = reports + document grids + dashboards; widget-type 7 = uses custom drop zones. -->
    <visualization-list name="ajax" show-in-web="true" view-mode="51">
        <visualization id="SvBulletChart"
                       desc="Bullet Chart"
                       style-name="SvBulletChart"
                       is-mojo="true"
                       scope="19"
                       widget-type="7"
                       attribute-minimum="1"
                       metric-minimum="1"
                       drop-zones="plugins.SvBulletChart.SvBulletChartDropZones"
                       editor-model="plugins.SvBulletChart.SvBulletChartEditorModel"
                       use-react-config="false"
                       use-binary-data="false"
                       categories="KPI,Custom"
                       summary="Compares an actual value to a target for each item, against poor / satisfactory / good bands"
                       use-case="Example: Revenue versus quota by sales region"
                       requirements="Uses 1+ ##attributes### and 1-2 #metrics###"/>
    </visualization-list>
</visualizations>
